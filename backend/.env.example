# Local dev needs nothing here — sane defaults apply.
# Copy to .env only if you want to override something.

# Where the SQLite file lives. Locally defaults to ./move.db; on Fly use /data/move.db.
# DB_PATH=./move.db

# Port the backend listens on (defaults to 4110 locally, 8080 in the container).
# PORT=4110

# Deploy-only: shared bearer token that gates /api. Leave unset for local dev.
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# APP_TOKEN=

# Deploy-only: your public URL, for the CORS allowlist.
# PUBLIC_ORIGIN=https://your-app.fly.dev
